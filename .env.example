# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk hosted-page routes (must match the app's catch-all auth routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where Clerk lands a user after auth when no explicit redirect_url is present.
# /after-sign-in routes by role: admins → /admin, everyone else → /account.
# (Authorization is still enforced server-side; this only controls landing UX.)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/after-sign-in

# Admin allowlist — server-only, comma-separated Clerk user IDs.
# REQUIRED: if this is empty, nobody can access /admin (fails closed).
# Find your ID in the Clerk dashboard under Users, e.g. user_2abc...,user_2def...
ADMIN_USER_IDS=

# WhatsApp enquiry number, digits only, country code first, no + or spaces.
# Format example (not a real number): 910000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact details shown on the site. Blank values render as blank.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_INSTAGRAM_URL=

# Canonical site origin, no trailing slash. Used by sitemap.xml and robots.txt.
# Defaults to http://localhost:3000 if unset, which must not ship to production.
NEXT_PUBLIC_SITE_URL=
